{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/file-size-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking file-size budget"
          }
        ]
      }
    ]
  }
}
