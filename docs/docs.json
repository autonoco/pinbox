{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Pinbox",
  "description": "Drop a pin on a live app. Your coding agent picks it up, fixes it, replies, and resolves it.",
  "colors": {
    "primary": "#d4a04a",
    "light": "#e0b86a",
    "dark": "#b07d28"
  },
  "logo": {
    "light": "/logo/mark-light.svg",
    "dark": "/logo/mark-dark.svg",
    "href": "https://pinbox.sh"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "DM Sans",
    "heading": {
      "family": "DM Sans",
      "weight": 500
    }
  },
  "background": {
    "color": {
      "light": "#f5f0e6",
      "dark": "#0f0f0f"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "pinbox.sh",
        "href": "https://pinbox.sh"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/autonoco/pinbox"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart", "installation"]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/overview",
          {
            "group": "Commands",
            "pages": [
              "cli/commands/overview",
              "cli/commands/pin",
              "cli/commands/init",
              "cli/commands/list",
              "cli/commands/show",
              "cli/commands/reply",
              "cli/commands/resolve",
              "cli/commands/summary",
              "cli/commands/link",
              "cli/commands/export",
              "cli/commands/doctor",
              "cli/commands/update"
            ]
          }
        ]
      },
      {
        "group": "Concepts",
        "pages": ["concepts/pins", "concepts/architecture", "concepts/agents"]
      },
      {
        "group": "Integrations",
        "pages": ["integrations/toolbar", "integrations/agents", "integrations/github"]
      },
      {
        "group": "Self-hosting",
        "pages": ["self-hosting/cloud", "self-hosting/security"]
      },
      {
        "group": "Contributing",
        "pages": ["contributing"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/autonoco/pinbox"
    },
    "links": [
      {
        "header": "Project",
        "items": [
          {
            "label": "pinbox.sh",
            "href": "https://pinbox.sh"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/autonoco/pinbox"
          },
          {
            "label": "Report an issue",
            "href": "https://github.com/autonoco/pinbox/issues"
          }
        ]
      }
    ]
  }
}
