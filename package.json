{
  "name": "pinbox-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "e2e",
      "examples/worker"
    ],
    "catalog": {
      "typescript": "^7.0.0",
      "zod": "^4.0.0",
      "tsdown": "^0.22.0",
      "@types/bun": "^1.3.0"
    }
  },
  "scripts": {
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tools/tsconfig.json",
    "test": "bun test",
    "agent:review": "fallow --group-by package",
    "agent:review:changed": "fallow audit --base main",
    "build": "bun run --filter '*' build",
    "test:workers": "bun run --filter '@autono/pinbox-e2e' test:workers",
    "lint:pkg": "publint packages/core && attw --pack packages/core --profile esm-only && publint packages/toolbar && attw --pack packages/toolbar --profile esm-only && publint packages/mcp && attw --pack packages/mcp --profile esm-only",
    "release:build": "bun tools/release/compile.ts",
    "release:publish": "bun tools/release/publish.ts",
    "ci:validate": "bun run check && bun run build && bun run typecheck && bun run test && bun run test:workers && bun tools/validate/template-drift.ts && bun tools/validate/hub-version.ts && bun run lint:pkg"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "catalog:",
    "commander": "^15.0.0",
    "fallow": "^3.13.0",
    "publint": "^0.3.23",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
