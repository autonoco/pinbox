{
  "name": "@autono/pinbox-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autonoco/pinbox.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "default": "./dist/hub.js"
    },
    "./hub-server": {
      "types": "./dist/hub-server.d.ts",
      "default": "./dist/hub-server.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./delivery": {
      "types": "./dist/delivery/router.d.ts",
      "default": "./dist/delivery/router.js"
    },
    "./delivery/resume": {
      "types": "./dist/delivery/resume.d.ts",
      "default": "./dist/delivery/resume.js"
    },
    "./delivery/openclaw": {
      "types": "./dist/delivery/openclaw.d.ts",
      "default": "./dist/delivery/openclaw.js"
    },
    "./delivery/webhook": {
      "types": "./dist/delivery/webhook.d.ts",
      "default": "./dist/delivery/webhook.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "default": "./dist/ws.js"
    },
    "./ws-protocol": {
      "types": "./dist/ws-protocol.d.ts",
      "default": "./dist/ws-protocol.js"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "default": "./dist/connectors/index.js"
    },
    "./connectors/github": {
      "types": "./dist/connectors/github.d.ts",
      "default": "./dist/connectors/github.js"
    },
    "./auth": {
      "types": "./dist/auth/verify.d.ts",
      "default": "./dist/auth/verify.js"
    },
    "./do": {
      "types": "./dist/do.d.ts",
      "default": "./dist/do.js"
    },
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "bun test"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "@types/bun": "catalog:",
    "@cloudflare/workers-types": "^4.20250801.0"
  }
}
